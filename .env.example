# ==========================================
# My Academia - Root Docker Environment Template
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=my_academia

# Backend Configuration
JWT_SECRET=replace_with_a_long_random_jwt_secret_key
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/my_academia?schema=public

# AI Service Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
INTERNAL_SERVICE_KEY=your_internal_shared_secret_between_services

# Ports (Optional overrides)
PORT=8080
