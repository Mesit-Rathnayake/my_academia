generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  registrationNumber String   @unique
  firstName          String   @default("Mesith")
  lastName           String   @default("Rathanayake")
  password           String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  universityConfigId String?
  universityConfig   UniversityConfig? @relation(fields: [universityConfigId], references: [id])
  modules            Module[]
  timetableEntries   TimetableEntry[]
  exams              Exam[]
  examSeries         ExamSeries[]
  notifications      Notification[]
}

model UniversityConfig {
  id                  String   @id @default(cuid())
  name                String   @unique
  gpaScale            Float    @default(4.0)
  rounding            Int      @default(2)
  creditRule          String   @default("MANUAL")
  gradingScale        Json
  classificationRules Json
  specialGrades       Json
  users               User[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Module {
  id                String       @id @default(cuid())
  moduleName        String       @db.VarChar(100)
  moduleCode        String       @db.VarChar(20)
  totalLectures     Int          @default(0)
  conductedLectures Int          @default(0)
  attendedLectures  Int          @default(0)
  semester          Int          @default(1)
  isGpaCounted      Boolean      @default(true)
  creditsOverride   Float?
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  labs              Lab[]
  assignments       Assignment[]
  documents         Document[]
  chatSessions      ChatSession[]
  timetableEntries  TimetableEntry[]
  exams             Exam[]
  moduleResults     ModuleResult[]

  @@unique([moduleCode, userId])
}

model ModuleResult {
  id              String   @id @default(cuid())
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attemptNumber   Int      @default(1)
  marks           Float?
  grade           String?
  isProperAttempt Boolean  @default(true)
  academicYear    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Lab {
  id         String    @id @default(cuid())
  name       String
  dueDate    DateTime?
  status     String    @default("Pending") // Pending, Submitted, Graded
  marks      Float?
  totalMarks Float?
  moduleId   String
  module     Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Assignment {
  id         String    @id @default(cuid())
  name       String
  dueDate    DateTime?
  status     String    @default("Pending") // Pending, Submitted, Graded
  marks      Float?
  totalMarks Float?
  moduleId   String
  module     Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Document {
  id        String   @id @default(cuid())
  name      String
  filepath  String
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ChatSession {
  id          String   @id @default(cuid())
  title       String   @default("New Chat")
  documentIds Json?    // JSON array of selected document IDs
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String   // "user" or "assistant"
  content   String
  sources   Json?    // Optional JSON array for the citations/sources
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TimetableEntry {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String   // e.g. "09:00"
  endTime   String   // e.g. "11:00"
  type      String   // e.g. "Lecture", "Lab", "Tutorial"
  location  String?
  moduleId  String?
  module    Module?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExamSeries {
  id        String   @id @default(cuid())
  title     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exams     Exam[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Exam {
  id           String      @id @default(cuid())
  title        String
  date         DateTime
  location     String?
  moduleId     String?
  module       Module?     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  examSeriesId String?
  examSeries   ExamSeries? @relation(fields: [examSeriesId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("INFO") // e.g. INFO, REMINDER, ALERT
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
