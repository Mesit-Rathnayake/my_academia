# Backend Service Environment Variables
PORT=8294
NODE_ENV=development

# Database Connection (Prisma) - Local SQLite or PostgreSQL
DATABASE_URL="file:./dev.db"

# Security & Auth
JWT_SECRET=your_super_secret_jwt_key
INTERNAL_SERVICE_KEY=my-academia-internal-secret
SEED_USER_PASSWORD=your_seed_password_here

# AI Service Connection
AI_SERVICE_URL=http://127.0.0.1:9142

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:4721,http://127.0.0.1:8080
